# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/localfind?schema=public"

# NextAuth configuration. Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Razorpay test keys. The public key must match the account behind the server keys.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-razorpay-test-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_me"

# Email verification via Resend. Required to deliver verification codes.
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="ShowListing <verify@example.com>"
